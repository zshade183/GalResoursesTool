NODE_ENV=development
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_API_KEY=
COMFYUI_URL=http://127.0.0.1:8188
# Optional: DATABASE_PATH=C:/path/to/studio.sqlite
API_HOST=127.0.0.1
API_PORT=3001
VITE_API_BASE_URL=http://127.0.0.1:3001


# Video generation (Runway developer account)
RUNWAYML_API_SECRET=
# Music / sound effects generation
ELEVENLABS_API_KEY=
# Optional video post-processing executable (otherwise searches PATH)
FFMPEG_PATH=
# Local character rehearsal; choose a model already installed in Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Optional permitted external sound search
FREESOUND_API_KEY=

# Per-project daily quota (Asia/Shanghai). Estimated costs are optional, not provider bills.
MAX_DAILY_GENERATIONS=100
USAGE_CURRENCY=USD
IMAGE_ESTIMATE_COST=
VIDEO_ESTIMATE_COST_PER_SECOND=
AUDIO_ESTIMATE_COST_PER_SECOND=
# When enabled, tasks without estimates or with unreconciled unknown amounts are blocked.
PROJECT_DAILY_BUDGET=
